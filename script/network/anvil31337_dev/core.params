# LOVE20Token 部署参数
TOKEN_NAME=TestLOVE20
TOKEN_SYMBOL=TestLOVE20@WBNB
INITIAL_SUPPLY=1000000000000000000000000000
MAX_SUPPLY=10000000000000000000000000000
# DISTRIBUTOR 使用部署钱包地址（anvil 默认账户）
DISTRIBUTOR=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# MINTER 留空，由 Mint 合约部署后再配置
MINTER=0x0000000000000000000000000000000000000000
# PARENT_TOKEN 引用 WBNB 地址，从 dex 部署产生
PARENT_TOKEN=${WBNB_ADDRESS}


# MemberNFT 部署参数
MEMBER_BASE_DIVISOR=100000000
MEMBER_BYTES_THRESHOLD=7
MEMBER_MULTIPLIER=10
MEMBER_MAX_NAME_LENGTH=32

# Phase 部署参数
PHASE_ORIGIN_BLOCKS=1
PHASE_ORIGIN_PHASE_BLOCKS=100
PHASE_TARGET_SECONDS=300
PHASE_ADJUST_THRESHOLD=600000000000000000
PHASE_SYNC_OBSERVATION_LIMIT=100
