# Dev/test profile: values are tuned so Phase and issuance advance within minutes; they are not the
# production deployment values, which are the examples in docs/whitepaper-core.md appendix A.
# LOVE20Token (the genesis token; LAUNCH_AMOUNT/MAX_SUPPLY also apply to every launched token)
TOKEN_NAME=TestLOVE20@TestWETH
TOKEN_SYMBOL=TestLOVE20
LAUNCH_AMOUNT=1e27                      # per token, 1e9 tokens; must be >= 1e18 (TOTAL_SHARE)
MAX_SUPPLY=1e28                         # 1e10 tokens
# Deploy wallet (anvil default account).
# The genesis token's first supply is minted to the AirdropDistributor deployed by 11_deploy.sh;
# DISTRIBUTOR_ADDRESS is gone - the distributor address is predicted (nonce+1) and fixed by the
# deployment order, not configured.
# Root MUST equal the merkle root of the snapshot actually served/seeded (the local fixture
# fixtures/airdrop/anvil31337_dev.json in the sibling `anvil` repo, root 0x046a5d53…). A mismatched
# root makes every claim revert InvalidProof while the chain still looks healthy. Kept in sync with
# anvil/params/anvil31337_dev/core.params (owner 2026-11-12).
GENESIS_AIRDROP_MERKLE_ROOT=0x046a5d5357fd4da6986a88fb1e2baf3603375d2099ce9f46b9d6fbe333c6c404
GENESIS_AIRDROP_CLAIM_DELAY_ROUNDS=1     # 首币可领取轮 = max(currentPhase,1) + 该值；<= 1000
# Root parent token is read from Router.WETH(); do not configure it here.

# MemberNFT
MEMBER_BASE_DIVISOR=1e7
MEMBER_BYTES_THRESHOLD=7
MEMBER_MULTIPLIER=10
MEMBER_MAX_NAME_LENGTH=32

# Phase
PHASE_ORIGIN_BLOCKS=1
PHASE_ORIGIN_PHASE_BLOCKS=120
PHASE_TARGET_SECONDS=120
PHASE_ADJUST_THRESHOLD=1e17             # 10%
PHASE_SYNC_OBSERVATION_LIMIT=10

# Launch
LAUNCH_COUNT_THRESHOLD_RATIO=1e17                       # 10%
MAX_LAUNCH_COUNT=10000
TOKEN_SYMBOL_LENGTH=6

# Mint (ratios: 1e18 = 100%)
PROPOSAL_REWARD_MIN_VOTE_RATIO=5e16     # 5%
ROUND_REWARD_GOV_RATIO=5e14             # 0.05%
ROUND_REWARD_PROPOSAL_RATIO=5e14        # 0.05%

# Submit (ratios: 1e18 = 100%)
SUBMIT_MIN_RATIO=5e15                   # 0.5%

# Stake
PROMISED_WAITING_PHASES_MIN=1
PROMISED_WAITING_PHASES_MAX=100
BOOST_STAKE_SUPPLY_FACTOR=2
BOOST_STAKE_MULTIPLIER=5
# Fee settlement share of the pair's LP supply (1e18 = 100%); must not exceed MAX_FEE_SETTLEMENT_RATIO (0.25%).
FEE_SETTLEMENT_RATIO=25e14              # 0.25%
